{
    "expo": {
    "name": "GlennTarotApp",
    "slug": "GlennTarotApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.hisimpson.GlennTarotApp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
   "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "이 식별자는 귀하에게 개인화된 광고를 제공하는 데 사용됩니다."
        }
      ],
      [
          "react-native-google-mobile-ads",
          {
              "androidAppId": "ca-app-pub-XXXXXXXXXXXX"
          }  
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "aa5783c2-85ef-4fdc-aad5-608b9ea6b0f1"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/aa5783c2-85ef-4fdc-aad5-608b9ea6b0f1"
    }
  }
}
